{
  "name": "app-library",
  "version": "1.0",
  "runtime": "npm",
  "entry": "start",
  "modes": [
    "tui",
    "graphical"
  ],
  "permissions": [
    "system"
  ],
  "description": "Every installed app. Pick one and the OS asks for your password to open it.",
  "commands": [
    {
      "id": "all",
      "title": "See every installed app",
      "keywords": [
        "launcher",
        "apps"
      ]
    }
  ]
}
