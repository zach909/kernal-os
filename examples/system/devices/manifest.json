{
  "name": "devices",
  "version": "1.0",
  "runtime": "npm",
  "entry": "start",
  "modes": [
    "tui"
  ],
  "permissions": [
    "ticks",
    "system:apps",
    "system:os"
  ],
  "description": "I/O devices: disks and their throughput, input devices, drivers, display, buffers and cache.",
  "commands": [
    {
      "id": "disks",
      "title": "Show disks and their speed",
      "keywords": [
        "storage",
        "ssd",
        "throughput"
      ]
    },
    {
      "id": "input",
      "title": "Show keyboards and mice",
      "keywords": [
        "keyboard",
        "mouse"
      ]
    }
  ]
}
