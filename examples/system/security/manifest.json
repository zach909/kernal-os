{
  "name": "security",
  "version": "1.0",
  "runtime": "npm",
  "entry": "start",
  "modes": [
    "tui"
  ],
  "permissions": [
    "system:apps",
    "system:files",
    "system:maintenance",
    "system:os",
    "system:updates"
  ],
  "description": "Security Center: administrator keyboard, kernel protections, what is owed, scans, audit trail.",
  "commands": [
    {
      "id": "settle",
      "title": "Settle scans and optimizes still owed",
      "keywords": [
        "owed",
        "pending",
        "scan"
      ]
    },
    {
      "id": "optimize",
      "title": "Optimize the disk now",
      "keywords": [
        "clean",
        "space"
      ]
    },
    {
      "id": "scan",
      "title": "Scan a path for viruses",
      "keywords": [
        "virus",
        "malware"
      ]
    }
  ]
}
