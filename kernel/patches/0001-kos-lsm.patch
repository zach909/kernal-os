+# SPDX-License-Identifier: GPL-2.0-only
+config SECURITY_KOS
+	bool "KOS security module"
+	depends on SECURITY
+	select SECURITYFS
+	select SECURITY_NETWORK
+	select SECURITY_PATH
+	default n
+	help
+	  The kernel half of KOS. It tells apps (processes the KOS core has
+	  confined) from the core, and for every confined process:
+
+	  - denies every connection (connect, bind, listen, send to an
+	    address) unless a firewall rule written by the core allows exactly
+	    that app, protocol, address and port;
+	  - denies opening any device node except null, zero, full, random and
+	    urandom, and creating any device node;
+	  - denies bpf(2), perf_event_open(2) and ptrace;
+	  - logs every allowed and every denied connection attempt, for the
+	    core to read into the audit log.
+
+	  Nothing is confined until the first process (init) claims the core
+	  and the core confines a child. Confinement is one way: it is
+	  inherited by every child and can never be lifted.
+
+	  If you are unsure how to answer this question, answer N.
