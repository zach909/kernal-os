# KOS kernel configuration fragment. Merge onto a defconfig:
#   scripts/kconfig/merge_config.sh -m .config /path/to/kos.config && make olddefconfig
#
# ---- Boot: pre-boot environment + encrypted root ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEYS=y
CONFIG_EXT4_FS=y

# ---- Boot from USB sticks (and SATA/NVMe/virtio disks) ----
# Built in, not modules: the pre-boot initramfs has no module loader and only
# signed modules are allowed, so the drivers that find the disk must be =y.
CONFIG_PCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- Apps: run from sealed memfd, confined by Landlock + namespaces ----
CONFIG_MEMFD_CREATE=y
CONFIG_TMPFS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_LSM="landlock,lockdown,yama,bpf"

# ---- Graphics and input (graphical mode, mouse/keyboard booting) ----
CONFIG_INPUT_EVDEV=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VT=y

# ---- Multi-kernel cells (host side) ----
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VSOCKETS=y
CONFIG_VHOST_VSOCK=y
# (cell guest kernels additionally need CONFIG_VIRTIO_VSOCKETS=y, CONFIG_VIRTIO_MMIO=y)

# ---- Memory-safety hardening ----
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PAGE_TABLE_ISOLATION=y

# ---- Hardware-backed hardening (docs/BLUEPRINT.md). NOT BUILT OR BOOTED:
# olddefconfig silently drops names this kernel version lacks; check .config. ----
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_DM_VERITY=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_GCC_PLUGINS=y
CONFIG_RANDSTRUCT_FULL=y
CONFIG_ZERO_CALL_USED_REGS=y

# ---- Only signed modules ----
CONFIG_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# ---- Remove attack surface ----
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_USELIB is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_ACPI_CUSTOM_METHOD is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_IO_URING is not set
# The OS's side of the machine's management processors (see kos/firmware.py). Not
# having these drivers does not switch the ME/PSP/BMC off; it only means nothing
# in this kernel talks to them.
# CONFIG_INTEL_MEI is not set
# CONFIG_INTEL_MEI_ME is not set
# CONFIG_INTEL_MEI_TXE is not set
# CONFIG_CRYPTO_DEV_CCP is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_USERFAULTFD is not set
